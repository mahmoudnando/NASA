# Auto-detect text files and normalize line endings
* text=auto

# Text files normalized to LF
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.ico binary

